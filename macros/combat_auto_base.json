{
  "name": "combat_auto_base",
  "description": "Base combat macro for modern auto-battle flow. Assumes the target stage is already selected or the combat UI is already open.",
  "steps": [
    {
      "action": "log",
      "message": "Starting base combat automation."
    },
    {
      "action": "sleep",
      "seconds": 5
    },
    {
      "action": "wait_for",
      "condition": {
        "type": "any",
        "items": [
          {
            "type": "image",
            "image": "combat/retirement"
          },
          {
            "type": "image",
            "image": "combat/repeat"
          },
          {
            "type": "image",
            "image": "combat/alert_morale_low"
          },
          {
            "type": "image",
            "image": "combat/alert_unable_battle"
          }
        ]
      },
      "timeout_steps": [
        {
          "action": "log",
          "message": "Timed out waiting for combat/retirement or combat/repeat."
        }
      ],
      "timeout": 300,
      "poll_seconds": 30
    },
    {
      "action": "if",
      "condition": {
        "type": "any",
        "items": [
          {
            "type": "image",
            "image": "combat/alert_morale_low",
            "use_mask": true,
            "similarity": 0.9
          },
          {
            "type": "image",
            "image": "combat/alert_unable_battle",
            "use_mask": true,
            "similarity": 0.9
          }
        ]
      },
      "steps": [
        {
          "action": "return",
          "value": false
        }
      ]
    },
    {
      "action": "if",
      "condition": {
        "type": "image",
        "image": "combat/retirement"
      },
      "steps": [
        {
          "action": "call",
          "routine": "retirement"
        },
        {
          "action": "continue"
        }
      ]
    },
    {
      "action": "tap_image",
      "image": "combat/repeat"
    }
  ],
  "routines": {
    "retirement": [
      {
        "action": "tap_region",
        "region": "retirement"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "retireall"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "confirm"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "update_screen"
      },
      {
        "action": "tap_image",
        "image": "combat/confirm"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "touch"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "disassembly"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "disassembly_ok"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "touch"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "tap_region",
        "region": "back"
      },
      {
        "action": "sleep",
        "seconds": 3
      },
      {
        "action": "update_screen"
      },
      {
        "action": "sleep",
        "seconds": 2
      },
      {
        "action": "tap_image",
        "image": "combat/auto_off",
        "similarity": 0.7
      },
      {
        "action": "sleep",
        "seconds": 3
      }
    ]
  },
  "regions": {
    "retirement": {
      "x": 585,
      "y": 732,
      "w": 147,
      "h": 64
    },
    "retireall": {
      "x": 980,
      "y": 970,
      "w": 203,
      "h": 60
    },
    "confirm": {
      "x": 1451,
      "y": 935,
      "w": 135,
      "h": 63
    },
    "touch": {
      "x": 345,
      "y": 164,
      "w": 1227,
      "h": 711
    },
    "disassembly": {
      "x": 1487,
      "y": 861,
      "w": 158,
      "h": 76
    },
    "disassembly_ok": {
      "x": 1139,
      "y": 816,
      "w": 133,
      "h": 69
    },
    "back": {
      "x": 55,
      "y": 47,
      "w": 56,
      "h": 68
    }
  }
}