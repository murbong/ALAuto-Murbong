    "collect_completed": [
      {
        "action": "tap_region",
        "region": "project_click"
      },
      {
        "action": "wait_update_screen",
        "seconds": 1
      },
      {
        "action": "if",
        "condition": {
          "type": "image",
          "image": "research/item_found"
        },
        "steps": [
          {
            "action": "tap_region",
            "region": "project_click"
          },
          {
            "action": "sleep",
            "seconds": 1
          },
          {
            "action": "tap_region",
            "region": "project_click"
          },
          {
            "action": "return",
            "value": true
          }
        ]
      },
      {
        "action": "repeat",
        "times": 5,
        "steps": [
          {
            "action": "tap_region",
            "region": "right_arrow"
          },
          {
            "action": "wait_update_screen",
            "seconds": 1
          },
          {
