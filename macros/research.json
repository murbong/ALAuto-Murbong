        "action": "return",
        "value": false
      }
    ]
  },
  "steps": [
    {
      "action": "tap_region",
      "region": "lab_tab"
    },
    {
      "action": "wait_update_screen",
      "seconds": 1
    },
    {
      "action": "if",
      "condition": {
        "type": "image",
        "image": "research/research_academy_alert",
        "similarity": 0.99
      },
      "steps": [
        {
          "action": "tap_region",
          "region": "research_academy"
        },
        {
          "action": "sleep",
          "seconds": 1
        },
        {
          "action": "call",
          "routine": "collect_completed",
          "into": "completed_found"
        },
        {
          "action": "set",
          "value": false,
          "var": "started"
        },
        {
          "action": "repeat",
          "times": 5,
          "steps": [
            {
              "action": "call",
              "routine": "project_matches",
              "into": "project_ok"
            },
            {
              "action": "if",
              "condition": {
                "type": "compare",
                "source": "var",
                "key": "project_ok",
                "op": "equals",
                "value": true
              },
              "steps": [
                {
                  "action": "call",
                  "routine": "start_project",
                  "into": "project_started"
                },
                {
                  "action": "if",
                  "condition": {
                    "type": "compare",
                    "source": "var",
                    "key": "project_started",
                    "op": "equals",
                    "value": true
                  },
                  "steps": [
                    {
                      "action": "set",
                      "value": true,
                      "var": "started"
                    },
                    {
                      "action": "break"
                    }
                  ]
                }
              ]
            },
            {
              "action": "tap_region",
              "region": "right_arrow"
            }
          ]
        }
      ]
    },
    {
      "action": "tap_region",
      "region": "main_menu_button"
    },
    {
      "action": "wait_update_screen",
      "seconds": 1
    },
    {
      "action": "return",
      "value": true
    }
  ]
}
