    "start_project": [
      {
        "action": "tap_region",
        "region": "commence_tab"
      },
      {
        "action": "wait_update_screen",
        "seconds": 1
      },
      {
        "action": "if",
        "condition": {
          "type": "image",
          "image": "research/terminate",
          "similarity": 0.99
        },
        "steps": [
          {
            "action": "return",
            "value": true
          }
        ]
      },
      {
        "action": "if",
        "condition": {
          "type": "image",
          "image": "research/confirm",
          "similarity": 0.99
        },
        "steps": [
          {
            "action": "tap_region",
            "region": "confirm_tab"
          },
          {
            "action": "wait_update_screen",
            "seconds": 1
          },
          {
            "action": "if",
            "condition": {
              "type": "image",
              "image": "research/terminate",
              "similarity": 0.99
            },
            "steps": [
              {
                "action": "return",
                "value": true
              }
            ]
          }
        ]
      },
